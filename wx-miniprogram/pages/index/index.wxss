.dashboard-page {
  padding-bottom: 48rpx;
}

.hero-panel {
  padding: 34rpx;
  color: #f8fff9;
  background: #173e35;
  border-radius: 16rpx;
}

.hero-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(248, 255, 249, 0.72);
  font-size: 24rpx;
}

.hero-amount {
  margin-top: 26rpx;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1.08;
}

.hero-meta {
  margin-top: 18rpx;
  color: rgba(248, 255, 249, 0.72);
  font-size: 24rpx;
}

.stat-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.stat-card {
  min-height: 112rpx;
  padding: 18rpx;
  background: #ffffff;
  border: 1rpx solid #dfe6df;
  border-radius: 16rpx;
}

.stat-label {
  display: block;
  color: #68746c;
  font-size: 22rpx;
}

.stat-value {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  font-weight: 700;
  word-break: break-all;
}

.action-row {
  margin-top: 22rpx;
  display: flex;
  gap: 16rpx;
}

.action-main {
  flex: 1;
}

.action-secondary {
  width: 156rpx;
}

.asset-row,
.snapshot-row {
  margin-bottom: 14rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 1rpx solid #dfe6df;
  border-radius: 16rpx;
}

.asset-main {
  min-width: 0;
  flex: 1;
}

.asset-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.asset-name {
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 29rpx;
  font-weight: 700;
}

.asset-type {
  padding: 4rpx 10rpx;
  color: #17694c;
  background: #e8f3ed;
  border-radius: 10rpx;
  font-size: 20rpx;
}

.asset-meta {
  margin-top: 10rpx;
  display: flex;
  gap: 16rpx;
  color: #68746c;
  font-size: 22rpx;
}

.asset-amount {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-size: 28rpx;
  font-weight: 700;
}

.asset-profit {
  margin-top: 8rpx;
  color: #17694c;
  font-size: 21rpx;
  font-weight: 500;
}

.snapshot-row {
  justify-content: flex-start;
  gap: 22rpx;
}

.snapshot-time {
  color: #68746c;
  font-size: 24rpx;
}

.snapshot-note {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.logout-button {
  margin-top: 42rpx;
}
