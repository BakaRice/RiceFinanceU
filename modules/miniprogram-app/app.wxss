page {
  min-height: 100vh;
  color: #161a1f;
  background: #f3f4f6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  font-size: 28rpx;
}

view,
text,
input,
textarea,
button {
  box-sizing: border-box;
}

button {
  border-radius: 12rpx;
  font-weight: 600;
}

button::after {
  border: 0;
}

.rf-page {
  min-height: 100vh;
  padding: 28rpx 26rpx 44rpx;
}

.page-state {
  min-height: 68vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  color: #7a838d;
}

.page-title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.2;
}

.page-subtitle {
  margin-top: 8rpx;
  color: #7a838d;
  font-size: 24rpx;
}

.primary-button {
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #2d5f7e;
  border-radius: 12rpx;
  font-size: 29rpx;
}

.primary-button[disabled] {
  color: rgba(255, 255, 255, 0.72);
  background: #9bb0bf;
}

.ghost-button {
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2d5f7e;
  background: #ffffff;
  border: 1rpx solid #d8dee5;
  border-radius: 12rpx;
  font-size: 27rpx;
}

.danger-button {
  color: #c0392b;
  background: #fff8f7;
  border-color: #efc7c0;
}

.muted-text {
  color: #7a838d;
}

.section-header {
  margin: 34rpx 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  color: #242a31;
  font-size: 28rpx;
  font-weight: 700;
}

.empty-text {
  padding: 30rpx 0;
  color: #7a838d;
  text-align: center;
  font-size: 25rpx;
}

.number-text {
  font-family: "DIN Alternate", "SF Pro Display", -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
}
