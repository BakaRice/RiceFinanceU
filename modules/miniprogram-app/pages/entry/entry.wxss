.entry-page {
  padding-bottom: 56rpx;
}

.entry-topbar {
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.entry-count {
  margin-top: 6rpx;
  color: #7a838d;
  font-size: 24rpx;
}

.entry-meta {
  margin-bottom: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.picker-field,
.note-field {
  background: #ffffff;
  border: 1rpx solid #dfe3e8;
  border-radius: 12rpx;
}

.picker-field {
  min-height: 84rpx;
  padding: 14rpx 18rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
  color: #20262d;
  font-size: 27rpx;
  font-weight: 700;
}

.picker-label,
.input-label {
  color: #7a838d;
  font-size: 22rpx;
  font-weight: 500;
}

.entry-table {
  background: #ffffff;
  border: 1rpx solid #dfe3e8;
  border-radius: 12rpx;
  overflow: hidden;
}

.entry-row {
  padding: 20rpx 18rpx;
  border-bottom: 1rpx solid #edf0f3;
}

.entry-row:last-child {
  border-bottom: 0;
}

.entry-row-muted {
  opacity: 0.48;
}

.entry-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.entry-asset-title {
  min-width: 0;
}

.entry-asset-name {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #20262d;
  font-size: 28rpx;
  font-weight: 700;
}

.entry-asset-type {
  display: block;
  margin-top: 6rpx;
  color: #7a838d;
  font-size: 22rpx;
}

.entry-fields {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 10rpx;
}

.entry-fields-invest {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.input-field {
  min-width: 0;
  padding: 12rpx 14rpx 10rpx;
  background: #f7f8fa;
  border: 1rpx solid #eef1f4;
  border-radius: 10rpx;
}

.entry-input {
  width: 100%;
  height: 48rpx;
  margin-top: 2rpx;
  color: #161a1f;
  font-size: 28rpx;
  font-weight: 700;
}

.note-field {
  margin-top: 18rpx;
  padding: 6rpx 18rpx;
}

.note-input {
  width: 100%;
  min-height: 104rpx;
  color: #161a1f;
  font-size: 27rpx;
}

.submit-button {
  margin-top: 22rpx;
}
