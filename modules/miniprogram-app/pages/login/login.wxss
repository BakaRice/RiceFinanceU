.login-page {
  padding-top: 118rpx;
}

.login-shell {
  min-height: 70vh;
  display: flex;
  flex-direction: column;
}

.login-hero {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.brand-mark {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #2d5f7e;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.brand-name {
  color: #161a1f;
  font-size: 38rpx;
  font-weight: 750;
  line-height: 1.1;
}

.login-form {
  margin-top: 58rpx;
}

.field {
  min-height: 98rpx;
  margin-bottom: 14rpx;
  padding: 16rpx 20rpx;
  background: #ffffff;
  border: 1rpx solid #dfe3e8;
  border-radius: 12rpx;
}

.field-label {
  display: block;
  color: #7a838d;
  font-size: 22rpx;
}

.field-input {
  height: 52rpx;
  margin-top: 4rpx;
  color: #161a1f;
  font-size: 29rpx;
}

.login-error {
  margin: 12rpx 0 20rpx;
  color: #c0392b;
  font-size: 24rpx;
}

.login-button {
  margin-top: 30rpx;
}
