.data-page {
  padding-bottom: 64rpx;
}

.data-panel {
  padding: 18rpx;
  background: #ffffff;
  border: 1rpx solid #dfe3e8;
  border-radius: 12rpx;
}

.data-button {
  width: 100%;
}

.import-box {
  margin: 16rpx 0;
  padding: 14rpx 16rpx;
  background: #f7f8fa;
  border: 1rpx solid #eef1f4;
  border-radius: 10rpx;
}

.import-textarea {
  width: 100%;
  min-height: 260rpx;
  color: #161a1f;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 23rpx;
  line-height: 1.45;
}
