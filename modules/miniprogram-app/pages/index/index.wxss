.dashboard-page {
  padding-bottom: 48rpx;
}

.dashboard-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.topbar-date {
  margin-top: 6rpx;
  color: #7a838d;
  font-size: 24rpx;
}

.balance-block {
  margin-top: 34rpx;
  padding: 30rpx 28rpx 28rpx;
  background: #ffffff;
  border: 1rpx solid #dfe3e8;
  border-radius: 12rpx;
}

.balance-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #7a838d;
  font-size: 23rpx;
}

.balance-amount {
  margin-top: 24rpx;
  color: #101418;
  line-height: 1;
  white-space: nowrap;
}

.money-prefix {
  margin-right: 6rpx;
  color: #2d5f7e;
  font-size: 34rpx;
  font-weight: 700;
}

.money-main {
  font-size: 68rpx;
  font-weight: 800;
}

.money-decimal {
  margin-left: 3rpx;
  color: #68717d;
  font-size: 36rpx;
  font-weight: 700;
}

.balance-meta {
  margin-top: 20rpx;
  color: #7a838d;
  font-size: 23rpx;
}

.metric-strip {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  border: 1rpx solid #dfe3e8;
  border-radius: 12rpx;
  background: #ffffff;
  overflow: hidden;
}

.metric-item {
  min-width: 0;
  padding: 18rpx 16rpx 16rpx;
  border-right: 1rpx solid #e9edf1;
}

.metric-item:last-child {
  border-right: 0;
}

.metric-label {
  display: block;
  color: #7a838d;
  font-size: 22rpx;
}

.metric-value {
  margin-top: 10rpx;
  color: #20262d;
  font-size: 25rpx;
  font-weight: 700;
  white-space: nowrap;
}

.metric-decimal {
  color: #7a838d;
  font-size: 21rpx;
}

.metric-prefix {
  margin-right: 2rpx;
}

.metric-profit .metric-value {
  color: #3a7d5a;
}

.metric-loss .metric-value {
  color: #c0392b;
}

.asset-table,
.snapshot-list {
  background: #ffffff;
  border: 1rpx solid #dfe3e8;
  border-radius: 12rpx;
  overflow: hidden;
}

.asset-row {
  min-height: 112rpx;
  padding: 22rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid #edf0f3;
}

.asset-row:last-child {
  border-bottom: 0;
}

.asset-main {
  min-width: 0;
  flex: 1;
}

.asset-title-line {
  display: flex;
  align-items: center;
}

.asset-name {
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #20262d;
  font-size: 28rpx;
  font-weight: 700;
}

.asset-meta {
  margin-top: 8rpx;
  display: flex;
  gap: 12rpx;
  color: #7a838d;
  font-size: 22rpx;
}

.asset-amount {
  width: 190rpx;
  min-width: 190rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.asset-money {
  color: #20262d;
  font-size: 29rpx;
  font-weight: 700;
  white-space: nowrap;
}

.asset-decimal {
  color: #7a838d;
  font-size: 23rpx;
}

.asset-cny {
  margin-top: 6rpx;
  color: #7a838d;
  font-size: 21rpx;
  white-space: nowrap;
}

.asset-profit {
  width: 112rpx;
  min-width: 112rpx;
  color: #8b949f;
  text-align: right;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

.profit-profit {
  color: #3a7d5a;
}

.profit-loss {
  color: #c0392b;
}

.snapshot-row {
  min-height: 82rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid #edf0f3;
}

.snapshot-row:last-child {
  border-bottom: 0;
}

.snapshot-time {
  width: 126rpx;
  min-width: 126rpx;
  color: #7a838d;
  font-size: 24rpx;
}

.snapshot-note {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #20262d;
  font-size: 26rpx;
}
