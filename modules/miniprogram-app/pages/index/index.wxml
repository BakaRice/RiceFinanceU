<view class="rf-page dashboard-page">
  <view wx:if="{{loading}}" class="page-state">
    <text>加载中...</text>
  </view>

  <view wx:elif="{{error}}" class="page-state">
    <text>{{error}}</text>
    <button class="ghost-button" bindtap="handleRefresh">重试</button>
  </view>

  <block wx:else>
    <view class="dashboard-topbar">
      <view>
        <view class="page-title">总览</view>
        <view class="topbar-date">{{latestLabel}}</view>
      </view>
    </view>

    <view class="balance-block">
      <view class="balance-label-row">
        <text>总资产</text>
        <text>CNY</text>
      </view>
      <view class="balance-amount number-text">
        <text class="money-prefix">{{summary.totalParts.prefix}}</text>
        <text class="money-main">{{summary.totalParts.main}}</text>
        <text class="money-decimal">{{summary.totalParts.decimal}}</text>
      </view>
      <view class="balance-meta">{{ratesLabel}}</view>
    </view>

    <view class="metric-strip">
      <view wx:for="{{statCards}}" wx:key="label" class="metric-item metric-{{item.tone}}">
        <text class="metric-label">{{item.label}}</text>
        <view class="metric-value number-text">
          <text class="metric-prefix">{{item.valueParts.prefix}}</text>
          <text>{{item.valueParts.main}}</text>
          <text class="metric-decimal">{{item.valueParts.decimal}}</text>
        </view>
      </view>
    </view>

    <view class="section-header">
      <text class="section-title">资产</text>
      <text class="muted-text">{{assetRows.length}} 项</text>
    </view>
    <view wx:if="{{assetRows.length === 0}}" class="empty-text">
      暂无资产
    </view>
    <view wx:else class="asset-table">
      <view wx:for="{{assetRows}}" wx:key="id" class="asset-row">
        <view class="asset-main">
          <view class="asset-title-line">
            <text class="asset-name">{{item.name}}</text>
          </view>
          <view class="asset-meta">
            <text>{{item.typeLabel}}</text>
            <text>{{item.currency}}</text>
          </view>
        </view>

        <view class="asset-amount">
          <view class="asset-money number-text">
            <text>{{item.amountParts.prefix}}</text>
            <text>{{item.amountParts.main}}</text>
            <text class="asset-decimal">{{item.amountParts.decimal}}</text>
          </view>
          <view wx:if="{{item.amountCNYParts}}" class="asset-cny number-text">
            <text>≈ </text>
            <text>{{item.amountCNYParts.prefix}}</text>
            <text>{{item.amountCNYParts.main}}</text>
            <text>{{item.amountCNYParts.decimal}}</text>
          </view>
        </view>

        <view class="asset-profit profit-{{item.profitTone}}">
          <view wx:if="{{item.profitParts}}" class="number-text">
            <text>{{item.profitParts.prefix}}</text>
            <text>{{item.profitParts.main}}</text>
            <text class="asset-decimal">{{item.profitParts.decimal}}</text>
          </view>
          <text wx:else>-</text>
        </view>
      </view>
    </view>

    <view class="section-header">
      <text class="section-title">快照</text>
      <text class="muted-text">{{snapshotRows.length}} 条</text>
    </view>
    <view wx:if="{{snapshotRows.length === 0}}" class="empty-text">
      暂无快照
    </view>
    <view wx:else class="snapshot-list">
      <view wx:for="{{snapshotRows}}" wx:key="id" class="snapshot-row">
        <text class="snapshot-time number-text">{{item.time}}</text>
        <text class="snapshot-note">{{item.note}}</text>
      </view>
    </view>
  </block>
</view>
